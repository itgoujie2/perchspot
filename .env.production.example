# ===========================================
# Perchspot Production Environment Configuration
# ===========================================
# Copy this file to .env.production and fill in all values
# NEVER commit .env.production to version control

# ===========================================
# Domain Configuration
# ===========================================
DOMAIN=yourdomain.com

# ===========================================
# Database (MySQL)
# ===========================================
# Generate strong random passwords (32+ characters):
# openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_RANDOM_32_CHAR
MYSQL_PASSWORD=CHANGE_ME_GENERATE_RANDOM_32_CHAR

# ===========================================
# S3/MinIO Storage
# ===========================================
# Generate random credentials:
# Access key: openssl rand -base64 15 | tr -dc 'A-Za-z0-9' | head -c 20
# Secret key: openssl rand -base64 30 | tr -dc 'A-Za-z0-9' | head -c 40
S3_ACCESS_KEY=CHANGE_ME_20_CHAR_RANDOM
S3_SECRET_KEY=CHANGE_ME_40_CHAR_RANDOM

# ===========================================
# API Keys
# ===========================================
# Required: At least one LLM provider
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GEMINI_API_KEY=

# Optional: Additional services
GOOGLE_MAPS_API_KEY=
GREATSCHOOLS_API_KEY=

# LLM Provider for Analysis (gemini or claude)
ANALYSIS_LLM_PROVIDER=gemini
ENABLE_PROPERTY_LLM_ANALYSIS=false

# ===========================================
# Stripe Payments (LIVE keys for production)
# ===========================================
# Get LIVE keys from: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use sk_live_ and pk_live_ keys, NOT sk_test_
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# Webhook secret from Stripe Dashboard -> Webhooks -> Add endpoint
# Endpoint URL: https://yourdomain.com/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ===========================================
# Security
# ===========================================
# Generate strong secrets:
# JWT: openssl rand -base64 48
# Admin: openssl rand -base64 24
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_RANDOM
ADMIN_PASSWORD=CHANGE_ME_GENERATE_32_CHAR_RANDOM

# ===========================================
# Production Settings
# ===========================================
DEBUG=False
LOG_LEVEL=WARNING

# ===========================================
# SSL Certificate (Let's Encrypt)
# ===========================================
# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=admin@yourdomain.com
