# Housing Analysis API - Environment Variables

# Application
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/housing_analysis

# Redis
REDIS_URL=redis://localhost:6379/0

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=housing-analysis

# API Keys
OPENAI_API_KEY=sk-...your-openai-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key-here...
GREATSCHOOLS_API_KEY=  # Optional

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_ANALYSES=5

# Caching
CACHE_TTL_HOURS=24

# LLM Configuration
LLM_MODEL=gpt-4o
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Computer Use Configuration
USE_COMPUTER_USE_SCRAPING=false
COMPUTER_USE_IMPLEMENTATION=simple  # "simple" (recommended) or "complex"

# Computer Use Development Mode
# Record real API responses for replay (one-time cost ~$1-2)
RECORD_COMPUTER_USE=false
# Replay recorded responses for $0 development cost
REPLAY_COMPUTER_USE=false
