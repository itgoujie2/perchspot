# ===========================================
# Perchspot Frontend Production Dockerfile
# Multi-stage build for optimized static files
# ===========================================

# Stage 1: Build the frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
RUN npm ci --only=production=false

# Copy source code
COPY . .

# Build argument for API URL
ARG VITE_API_URL=https://localhost
ENV VITE_API_URL=${VITE_API_URL}

# Build the application
RUN npm run build

# Stage 2: Production - copy built files to volume
FROM alpine:latest

# Copy built files to /build (not /app/dist, since that's the volume mount point)
COPY --from=builder /app/dist /build

# Copy files from /build to the mounted volume at /app/dist
CMD ["sh", "-c", "cp -r /build/* /app/dist/ && echo 'Build complete' && ls -la /app/dist/"]
